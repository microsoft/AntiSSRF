{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "outDir": "out",
    "esModuleInterop": true,
    "declaration": true,
    "removeComments": false,
    "types": ["node", "mocha"]
  },
  "include": ["src", "tests"],
  "exclude": ["out"]
}
