{
    "name": "@microsoft/antissrf",
    "version": "1.0.0",
    "description": "A library to prevent SSRF vulnerabilities in Node.js applications",
    "keywords": [
        "ssrf",
        "anti-ssrf",
        "security",
        "sanitizer",
        "url-validation"
    ],
    "main": "./out/src/index.js",
    "types": "./out/src/index.d.ts",
    "files": [
        "out/src/**/*",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "license": "MIT",
    "homepage": "https://microsoft.github.io/AntiSSRF/",
    "repository": {
        "type": "git",
        "url": "https://github.com/microsoft/AntiSSRF.git"
    },
    "bugs": {
        "url": "https://github.com/microsoft/AntiSSRF/issues",
        "email": "antissrf-oss@microsoft.com"
    },
    "scripts": {
        "build": "tsc --project ./tsconfig.json",
        "format": "prettier --write .",
        "lint": "eslint src",
        "test": "npm run build && cd out/tests && node --test --test-concurrency=1",
        "test:unit": "npm run build && cd out/tests/UnitTests && node --test",
        "test:functional": "npm run build && cd out/tests/FunctionalTests && node --test --test-concurrency=1",
        "test:prepublish": "npm run build && npm pack && cd tests/PrePublishTests && node --test"
    },
    "author": "Microsoft",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/follow-redirects": "^1.14.4",
        "@types/node": ">=20.0.0",
        "@types/node-fetch": "^2.6.13",
        "axios": "^1.21.0",
        "eslint": "^10.13.0",
        "eslint-plugin-security": "^4.2.0",
        "follow-redirects": "^1.16.2",
        "node-fetch": "^3.3.2",
        "prettier": "^3.9.10",
        "tar": "^7.5.22",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    },
    "overrides": {
        "minimatch": "11.0.1"
    }
}